    {
      "name": "transactions",
      "item": [
        {
          "name": "authrep.xml",
          "item": [
            {
              "name": "Authorize and Report API Transaction",
              "id": "3ee95bbd-43a8-456a-9e7a-8dd11ef2f8bd",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/xml"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/transactions/authrep.xml?provider_key=<string>&user_key=<string>&service_id=<string>&usage[hits]=1",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "transactions",
                    "authrep.xml"
                  ],
                  "query": [
                    {
                      "description": "(Required) The provider key identifying your 3scale account",
                      "key": "provider_key",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The API key of the application making the call",
                      "key": "user_key",
                      "value": "<string>"
                    },
                    {
                      "description": "The ID of the service being accessed",
                      "key": "service_id",
                      "value": "<string>"
                    },
                    {
                      "description": "Number of hits to report",
                      "key": "usage[hits]",
                      "value": "1"
                    }
                  ]
                },
                "description": "Combines authorization and reporting in a single call. Authorizes the API call and simultaneously reports usage metrics to 3scale. This is the recommended approach for reporting hits and other metrics."
              },
              "response": [
                {
                  "id": "4d986140-fbc4-4340-a2ac-59dc873a8c21",
                  "name": "Authorization and report successful",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/xml"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/transactions/authrep.xml?provider_key=<string>&user_key=<string>&service_id=<string>&usage[hits]=1&access_token=<API Key>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "transactions",
                        "authrep.xml"
                      ],
                      "query": [
                        {
                          "description": "(Required) The provider key identifying your 3scale account",
                          "key": "provider_key",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The API key of the application making the call",
                          "key": "user_key",
                          "value": "<string>"
                        },
                        {
                          "description": "The ID of the service being accessed",
                          "key": "service_id",
                          "value": "<string>"
                        },
                        {
                          "description": "Number of hits to report",
                          "key": "usage[hits]",
                          "value": "1"
                        },
                        {
                          "description": "Added as a part of security scheme: apikey",
                          "key": "access_token",
                          "value": "<API Key>"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "xml",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/xml"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <status>(string)</status>\n  <plan>(string)</plan>\n  <usage_reports>\n    <metric>(string)</metric>\n    <period>(string)</period>\n    <period_start>(string)</period_start>\n    <period_end>(string)</period_end>\n    <max_value>(integer)</max_value>\n    <current_value>(integer)</current_value>\n  </usage_reports>\n  <usage_reports>\n    <metric>(string)</metric>\n    <period>(string)</period>\n    <period_start>(string)</period_start>\n    <period_end>(string)</period_end>\n    <max_value>(integer)</max_value>\n    <current_value>(integer)</current_value>\n  </usage_reports>\n</element>",
