                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/boot?access_token=<API Key>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "boot"
                  ],
                  "query": [
                    {
                      "description": "Added as a part of security scheme: apikey",
                      "key": "access_token",
                      "value": "<API Key>"
                    }
                  ]
                }
              },
