      "name": "boot",
      "item": [
        {
          "name": "Boot Gateway",
          "id": "f37a9369-04fe-48f8-b670-0e3c68154a7c",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boot"
              ]
            },
            "description": "Triggers the APIcast initialization process, causing the gateway to attempt to download a new configuration from the 3scale management API. This is useful for forcing a configuration refresh."
          },
          "response": [
            {
              "id": "fed7b96f-afaf-4a82-8780-53f562f6ab9f",
              "name": "Boot process initiated successfully",
              "originalRequest": {
