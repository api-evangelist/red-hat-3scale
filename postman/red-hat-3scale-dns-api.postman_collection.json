          "name": "cache",
          "item": [
            {
              "name": "Get DNS Cache",
              "id": "e1f7a0fe-d908-43c5-a3d0-1eb9f2d95e82",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/dns/cache",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "dns",
                    "cache"
                  ]
                },
                "description": "Returns the current state of the APIcast DNS cache including cached records, their expiration times, and resolved IP addresses. Useful for debugging DNS resolution issues."
              },
              "response": [
                {
                  "id": "fb708481-211c-485d-b5fb-0a7226eb14c1",
                  "name": "DNS cache contents returned",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/dns/cache?access_token=<API Key>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "dns",
                        "cache"
                      ],
                      "query": [
                        {
                          "description": "Added as a part of security scheme: apikey",
                          "key": "access_token",
                          "value": "<API Key>"
                        }
                      ]
                    }
                  },
                  "status": "OK",
