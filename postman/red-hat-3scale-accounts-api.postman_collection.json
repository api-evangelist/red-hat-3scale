        {
          "name": "List Developer Accounts",
          "id": "a4f244fd-a9cb-4c83-9ef9-d1fa7c93d9ca",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts.json?access_token=<string>&state=approved&page=1&per_page=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts.json"
              ],
              "query": [
                {
                  "description": "(Required) Admin API access token",
                  "key": "access_token",
                  "value": "<string>"
                },
                {
                  "description": "Filter accounts by state",
                  "key": "state",
                  "value": "approved"
                },
                {
                  "description": "Page number for pagination",
                  "key": "page",
                  "value": "1"
                },
                {
                  "description": "Number of results per page (max 500)",
                  "key": "per_page",
                  "value": "20"
                }
              ]
            },
            "description": "Returns a list of developer accounts in the 3scale admin portal. Supports filtering by state (approved, pending, rejected) and pagination with per_page and page parameters."
