{
  "opencollection": "1.0.0",
  "info": {
    "name": "Red Hat 3scale Account Management Accounts Plans API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access_token",
      "value": "{{access_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Plans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Application Plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}-admin.3scale.net/admin/api/application_plans.json",
            "params": [
              {
                "name": "access_token",
                "value": "",
                "type": "query",
                "description": "Admin API access token"
              }
            ]
          },
          "docs": "Returns all application plans across all services."
        }
      ]
    }
  ],
  "bundled": true
}