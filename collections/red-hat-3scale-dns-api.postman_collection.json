                    "cache"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "access_token",
                      "value": "<API Key>"
                    }
                  ],
                  "variable": [
                    {
                      "description": "Your 3scale tenant domain",
                      "type": "any",
                      "value": "{{domain}}",
                      "key": "domain"
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
