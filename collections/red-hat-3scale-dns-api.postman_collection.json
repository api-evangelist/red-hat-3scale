          "id": "8648e417-a530-4224-a8fc-eabffff12626",
          "name": "Get DNS Cache",
          "request": {
            "name": "Get DNS Cache",
            "description": {
              "content": "Returns the current state of the APIcast DNS cache including cached records, their expiration times, and resolved IP addresses. Useful for debugging DNS resolution issues.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dns",
                "cache"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your 3scale tenant domain",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c7524df4-f7a0-40fd-849a-cece271afc4a",
              "name": "DNS cache contents returned",
