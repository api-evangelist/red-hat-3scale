                  "value": "application/json"
                }
              ],
              "body": "{\n  \"dns_cache\": [\n    {\n      \"name\": \"string\",\n      \"addresses\": [\n        \"string\",\n        \"string\"\n      ],\n      \"expire\": 7027.264581137338\n    },\n    {\n      \"name\": \"string\",\n      \"addresses\": [\n        \"string\",\n        \"string\"\n      ],\n      \"expire\": 3911.5149471744394\n    }\n  ]\n}",
