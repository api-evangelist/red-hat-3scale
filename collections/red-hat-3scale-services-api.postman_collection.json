        {
          "id": "2c2572b0-e89a-44b6-9d1a-ebd89a6d1ccc",
          "name": "Get Service Usage",
          "request": {
            "name": "Get Service Usage",
            "description": {
              "content": "Returns usage statistics for a specific API service. Supports filtering by metric, time period, granularity, and date range. Results include hit counts, response time, and other tracked metrics.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "services",
                ":service_id",
                "usage.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "access_token",
                  "value": "<string>",
                  "description": "(Required) Admin API access token"
                },
                {
                  "disabled": false,
                  "key": "metric_name",
                  "value": "<string>",
                  "description": "(Required) The name of the metric to retrieve (e.g., hits)"
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "(Required) The time period for the statistics"
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Start date for custom date range (ISO 8601 format)"
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "End date for custom date range (ISO 8601 format)"
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "<string>",
                  "description": "Granularity of data points within the period"
                },
                {
                  "disabled": false,
                  "key": "skip_change",
                  "value": "false",
                  "description": "Skip change data in response"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "service_id",
                  "description": "(Required) The ID of the API service"
                },
                {
                  "description": "Your 3scale tenant domain",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
