  "info": {
    "_postman_id": "78f81408-e81f-4ba5-a07c-6a237b13a84e",
    "name": "Red Hat 3scale Account Management Accounts Services API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The 3scale Account Management API provides programmatic access to manage developer accounts, applications, application plans, keys, and API subscriptions within the 3scale platform. It enables automation of developer onboarding, subscription management, and application lifecycle operations. All endpoints require admin API credentials and are accessible on the admin domain at {your-domain}-admin.3scale.net.\n\nContact Support:\n Name: Red Hat 3scale Support",
      "type": "text/plain"
    }
  }
