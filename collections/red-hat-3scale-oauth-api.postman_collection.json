  "item": [
    {
      "id": "7f6d0bc2-9f59-414e-9156-7fb789e0f7d6",
      "name": "OAuth",
      "description": {
        "content": "OAuth 2.0 token authorization endpoints",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "70d92fb8-412b-4b88-8be8-c8d253222241",
          "name": "Authorize OAuth Token",
          "request": {
            "name": "Authorize OAuth Token",
            "description": {
              "content": "Authorizes an OAuth 2.0 access token against the 3scale service, checking whether the token is valid and within usage limits. Returns the application and plan details associated with the token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transactions",
                "oauth_authorize.xml"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "provider_key",
                  "value": "<string>",
                  "description": "(Required) The provider key identifying your 3scale account"
                },
                {
                  "disabled": false,
                  "key": "access_token",
                  "value": "<string>",
                  "description": "(Required) The OAuth 2.0 access token to authorize"
                },
                {
                  "disabled": false,
                  "key": "service_id",
                  "value": "<string>",
                  "description": "The ID of the service being accessed"
                }
              ],
              "variable": [
                {
                  "description": "Your 3scale tenant domain",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "f809d851-3af7-4a01-9821-198d471c46a6",
              "name": "OAuth token authorized successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "transactions",
                    "oauth_authorize.xml"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "provider_key",
                      "value": "<string>"
                    },
                    {
                      "key": "access_token",
                      "value": "<string>"
                    },
                    {
                      "key": "service_id",
                      "value": "<string>"
                    },
                    {
                      "key": "access_token",
                      "value": "<API Key>"
                    }
                  ],
                  "variable": [
                    {
                      "description": "Your 3scale tenant domain",
                      "type": "any",
                      "value": "{{domain}}",
                      "key": "domain"
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/xml"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/xml"
                }
              ],
              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <status>(string)</status>\n  <application>\n    <id>(string)</id>\n    <key>(string)</key>\n    <redirect_url>(string)</redirect_url>\n  </application>\n</element>",
              "cookie": [],
              "_postman_previewlanguage": "xml"
            },
            {
