  "info": {
    "_postman_id": "ead5223b-02ff-43b2-8018-d4ee5b22cad3",
    "name": "Red Hat 3scale APIcast Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The APIcast Management API is an HTTP REST interface exposed by the APIcast API gateway on port 8090 for debugging and runtime configuration management. It provides endpoints to retrieve and update the gateway configuration, inspect DNS cache state, trigger boot/initialization sequences, and check readiness and liveness health status. Access level is controlled via the APICAST_MANAGEMENT_API environment variable (debug, status, or disabled). This API is intended for debugging and is not production-hardened.\n\nContact Support:\n Name: Red Hat 3scale Support",
      "type": "text/plain"
    }
  }
